<?xml version="1.0"?>
<!--
  Lukasiewicz-PIAP HUNTeR unmanned ground vehicle - URDF replica.

  Arguments
    sim_mode        none | gz | mock | hardware   (ros2_control backend; none = no ros2_control tag)
    controllers_file  absolute path of the ros2_control controller YAML (required for sim_mode:=gz)
    variant         2020 | 2023                     (2020 prototype 3.5 t with PTZ mast and top-view
                                                     cameras; 2023+ armed-era 4.05 t with stereo camera)
    payload         none | cargo | rws | uav_pad      (mission module on the deck)
    cargo_mass      kg, 0 = default from vehicle.yaml (payload:=cargo only)
    sensors         true | false                    (lidars, cameras, GNSS, IMU, PTZ)
    camera_sensors  true | false                    (Gazebo camera sensors; frames are always present)
    lidar_resolution  0..1 fraction of the lidar's native horizontal samples simulated
    visual_detail   mesh | primitive                (primitive = boxes/cylinders, faster rendering)
    vehicle_file    path of the vehicle parameter YAML (defaults to config/vehicle.yaml)

  All dimensions, masses, spring rates and limits come from vehicle.yaml,
  generated by tools/vehicle_design.py (see docs/).
-->
<robot name="hunter" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="sim_mode" default="none"/>
  <xacro:arg name="controllers_file" default=""/>
  <xacro:arg name="variant" default="2020"/>
  <xacro:arg name="payload" default="none"/>
  <xacro:arg name="cargo_mass" default="0"/>
  <xacro:arg name="sensors" default="true"/>
  <xacro:arg name="camera_sensors" default="true"/>
  <xacro:arg name="lidar_resolution" default="0.5"/>
  <xacro:arg name="visual_detail" default="mesh"/>
  <xacro:arg name="vehicle_file" default="$(find hunter_description)/config/vehicle.yaml"/>

  <xacro:property name="V" value="${xacro.load_yaml('$(arg vehicle_file)')}"/>
  <xacro:property name="sim_mode" value="$(arg sim_mode)"/>
  <!-- Normalise booleans; compare the variant with str(variant) (xacro turns '2020' into an int). -->
  <xacro:property name="variant" value="$(arg variant)"/>
  <xacro:property name="payload" value="$(arg payload)"/>
  <xacro:property name="cargo_mass" value="$(arg cargo_mass)"/>
  <xacro:property name="sensors_on" value="${'$(arg sensors)'.lower() in ('true', '1')}"/>
  <xacro:property name="camera_sensors" value="${'$(arg camera_sensors)'.lower() in ('true', '1')}"/>
  <xacro:property name="lidar_resolution" value="$(arg lidar_resolution)"/>
  <xacro:property name="has_ptz" value="${sensors_on and str(variant) in V.ptz.variants and payload != 'rws'}"/>
  <xacro:property name="visual_detail" value="$(arg visual_detail)"/>

  <xacro:include filename="$(find hunter_description)/urdf/include/common.xacro"/>
  <xacro:include filename="$(find hunter_description)/urdf/include/chassis.xacro"/>
  <xacro:include filename="$(find hunter_description)/urdf/include/suspension.xacro"/>
  <xacro:include filename="$(find hunter_description)/urdf/include/sensors.xacro"/>
  <xacro:include filename="$(find hunter_description)/urdf/include/payloads.xacro"/>
  <xacro:include filename="$(find hunter_description)/urdf/include/ros2_control.xacro"/>
  <xacro:include filename="$(find hunter_description)/urdf/include/gazebo.xacro"/>

  <xacro:hunter_chassis/>

  <xacro:hunter_axle axle="front" x="${0.5 * V.chassis.wheelbase}" static_load="${V.suspension.static_load_front}"/>
  <xacro:hunter_axle axle="rear" x="${-0.5 * V.chassis.wheelbase}" static_load="${V.suspension.static_load_rear}"/>

  <xacro:if value="${sensors_on}">
    <xacro:hunter_sensors/>
  </xacro:if>

  <xacro:hunter_payload payload="${payload}"/>

  <xacro:unless value="${sim_mode == 'none'}">
    <xacro:hunter_ros2_control sim_mode="${sim_mode}"/>
  </xacro:unless>
  <xacro:if value="${sim_mode == 'gz'}">
    <xacro:hunter_gazebo controllers_file="$(arg controllers_file)"/>
  </xacro:if>

</robot>
