<?xml version="1.0"?>
<!-- Rigid (beam) axles located by a 3-link + Panhard rod linkage, coil-over
     spring/damper units.

     A 3-link + Panhard rod leaves the axle two degrees of freedom relative to
     the hull: vertical travel (heave) and roll about a longitudinal axis
     through the Panhard rod (articulation). URDF cannot hold the closed
     linkage loops, so each axle is modelled by the equivalent open chain

       base_link  (prismatic z, heave)  [axle]_axle_heave_link
                  (revolute x, roll)    [axle]_axle_link

     with the two coil-overs lumped into equivalent heave and roll springs and
     dampers (see docs/SUSPENSION_DESIGN.md):
       k_heave = 2 k_w            c_heave = 2 c_w
       k_roll  = 2 k_w (s/2)^2    c_roll  = 2 c_w (s/2)^2
     with k_w, c_w the wheel-rate spring and damper per side and s the
     spring track. The heave spring reference is set so that q = 0 at the
     kerb-weight static equilibrium; extra payload sags the suspension.
     The physical links (lower trailing arms, upper link, Panhard rod,
     dampers) are drawn by the linkage visualiser (hunter_control). -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="hunter_axle" params="axle x static_load">
    <xacro:property name="S" value="${V.suspension}"/>
    <xacro:property name="kw" value="${S.wheel_rate}"/>
    <xacro:property name="cw" value="${S.damping_wheel}"/>
    <xacro:property name="half_s" value="${0.5 * S.spring_track}"/>
    <xacro:property name="k_heave" value="${2.0 * kw}"/>
    <xacro:property name="k_roll" value="${2.0 * kw * half_s * half_s + S.anti_roll_stiffness}"/>
    <xacro:property name="h_rc" value="${S.roll_center_height}"/>

    <joint name="${axle}_axle_heave_joint" type="prismatic">
      <parent link="base_link"/>
      <child link="${axle}_axle_heave_link"/>
      <origin xyz="${x} 0 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="${-S.travel_rebound}" upper="${S.travel_bump}" effort="${S.joint_effort_limit}" velocity="${S.joint_velocity_limit}"/>
      <dynamics damping="${2.0 * cw}" friction="${S.coulomb_friction}"/>
    </joint>
    <gazebo reference="${axle}_axle_heave_joint">
      <springStiffness>${k_heave}</springStiffness>
      <springReference>${-static_load / k_heave}</springReference>
    </gazebo>

    <link name="${axle}_axle_heave_link">
      <xacro:inertial_tiny/>
    </link>

    <joint name="${axle}_axle_roll_joint" type="revolute">
      <parent link="${axle}_axle_heave_link"/>
      <child link="${axle}_axle_link"/>
      <!-- Roll axis at Panhard rod height on the vehicle centreline. -->
      <origin xyz="0 0 ${h_rc}" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="${-radians(S.articulation_limit_deg)}" upper="${radians(S.articulation_limit_deg)}"
             effort="${S.joint_effort_limit}" velocity="${S.joint_velocity_limit}"/>
      <dynamics damping="${2.0 * cw * half_s * half_s}" friction="0"/>
    </joint>
    <gazebo reference="${axle}_axle_roll_joint">
      <springStiffness>${k_roll}</springStiffness>
      <springReference>0.0</springReference>
    </gazebo>

    <!-- Axle housing: beam, differential, traction motor, hubs' inner parts.
         Frame origin on the roll axis; the axle centreline is h_rc below. -->
    <link name="${axle}_axle_link">
      <!-- The traction motor on the pinion shifts the COM toward the vehicle centre. -->
      <xacro:property name="com_x" value="${-V.axle.com_x_toward_centre if axle == 'front' else V.axle.com_x_toward_centre}"/>
      <xacro:inertial_tensor mass="${V.axle.mass}" xyz="${com_x} 0 ${-h_rc + V.axle.com_z_offset}"
                             ixx="${V.axle.ixx}" iyy="${V.axle.iyy}" izz="${V.axle.izz}"/>
      <xacro:if value="${visual_detail == 'mesh'}">
        <xacro:mesh_visual name="housing" file="axle_housing.stl" material="hunter_green_dark"
                           xyz="0 0 ${-h_rc}" rpy="0 0 ${0 if axle == 'front' else pi}"/>
        <xacro:mesh_visual name="motor" file="axle_motor.stl" material="steel_dark"
                           xyz="0 0 ${-h_rc}" rpy="0 0 ${0 if axle == 'front' else pi}"/>
        <xacro:mesh_visual name="steering_actuator" file="steering_actuator.stl" material="steel"
                           xyz="0 0 ${-h_rc}" rpy="0 0 ${0 if axle == 'front' else pi}"/>
      </xacro:if>
      <xacro:unless value="${visual_detail == 'mesh'}">
        <visual>
          <origin xyz="0 0 ${-h_rc}" rpy="${pi/2} 0 0"/>
          <geometry><cylinder radius="${V.axle.housing_radius}" length="${V.steering.kingpin_track - 0.2}"/></geometry>
          <material name="hunter_green_dark"/>
        </visual>
        <visual>
          <origin xyz="0 0 ${-h_rc}" rpy="0 0 0"/>
          <geometry><sphere radius="${V.axle.diff_radius}"/></geometry>
          <material name="hunter_green_dark"/>
        </visual>
      </xacro:unless>
      <!-- Differential housing as collision: it is the lowest point of the
           vehicle and defines the under-axle clearance. -->
      <collision>
        <origin xyz="0 0 ${-h_rc}" rpy="0 0 0"/>
        <geometry><sphere radius="${V.axle.diff_radius}"/></geometry>
      </collision>
    </link>

    <xacro:hunter_corner axle="${axle}" side="left" y_sign="1"/>
    <xacro:hunter_corner axle="${axle}" side="right" y_sign="-1"/>
  </xacro:macro>

  <!-- ============================================ steering knuckle + wheel -->
  <xacro:macro name="hunter_corner" params="axle side y_sign">
    <xacro:property name="W" value="${V.wheel}"/>
    <xacro:property name="h_rc" value="${V.suspension.roll_center_height}"/>
    <xacro:property name="kp_off" value="${0.5 * (V.chassis.track - V.steering.kingpin_track)}"/>
    <!-- Wheels: left mesh, yawed by pi on the right. Knuckles: the rear axle is
         a front axle turned by pi, so it carries the opposite-side knuckle. -->
    <xacro:property name="mirror" value="${0 if y_sign == 1 else pi}"/>
    <xacro:property name="knuckle_mesh" value="${('knuckle_left.stl' if y_sign == 1 else 'knuckle_right.stl') if axle == 'front' else ('knuckle_right.stl' if y_sign == 1 else 'knuckle_left.stl')}"/>
    <xacro:property name="knuckle_yaw" value="${0 if axle == 'front' else pi}"/>

    <joint name="${axle}_${side}_steer_joint" type="revolute">
      <parent link="${axle}_axle_link"/>
      <child link="${axle}_${side}_knuckle_link"/>
      <origin xyz="0 ${y_sign * 0.5 * V.steering.kingpin_track} ${-h_rc}" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="${-radians(V.steering.max_angle_deg)}" upper="${radians(V.steering.max_angle_deg)}"
             effort="${V.steering.knuckle_torque_limit}" velocity="${radians(V.steering.max_rate_deg_s) * 1.5}"/>
      <dynamics damping="${V.steering.knuckle_damping}" friction="0"/>
    </joint>

    <!-- Knuckle, hub reduction, brake disc and caliper. -->
    <link name="${axle}_${side}_knuckle_link">
      <xacro:inertial_box mass="${V.axle.knuckle_mass}" x="0.30" y="0.25" z="0.35">
        <origin xyz="0 ${y_sign * 0.5 * kp_off} 0" rpy="0 0 0"/>
      </xacro:inertial_box>
      <xacro:if value="${visual_detail == 'mesh'}">
        <xacro:mesh_visual name="knuckle" file="${knuckle_mesh}" material="steel_dark" rpy="0 0 ${knuckle_yaw}"/>
      </xacro:if>
      <xacro:unless value="${visual_detail == 'mesh'}">
        <visual>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry><cylinder radius="0.07" length="0.34"/></geometry>
          <material name="steel_dark"/>
        </visual>
      </xacro:unless>
    </link>

    <joint name="${axle}_${side}_wheel_joint" type="continuous">
      <parent link="${axle}_${side}_knuckle_link"/>
      <child link="${axle}_${side}_wheel_link"/>
      <origin xyz="0 ${y_sign * kp_off} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="${V.drive.wheel_torque_limit}" velocity="${V.drive.wheel_max_speed}"/>
      <dynamics damping="${V.drive.wheel_bearing_damping}" friction="0"/>
    </joint>

    <link name="${axle}_${side}_wheel_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${W.mass}"/>
        <inertia ixx="${W.ixx}" ixy="0" ixz="0" iyy="${W.iyy}" iyz="0" izz="${W.ixx}"/>
      </inertial>
      <xacro:if value="${visual_detail == 'mesh'}">
        <xacro:mesh_visual name="tyre" file="tyre.stl" material="tyre_black" rpy="0 0 ${mirror}"/>
        <xacro:mesh_visual name="rim" file="rim.stl" material="rim_dark" rpy="0 0 ${mirror}"/>
        <xacro:mesh_visual name="hub" file="hub.stl" material="steel" rpy="0 0 ${mirror}"/>
      </xacro:if>
      <xacro:unless value="${visual_detail == 'mesh'}">
        <visual>
          <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
          <geometry><cylinder radius="${0.5 * W.diameter}" length="${W.width}"/></geometry>
          <material name="tyre_black"/>
        </visual>
      </xacro:unless>
      <collision name="${axle}_${side}_tyre_collision">
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${W.collision_radius}" length="${W.width}"/></geometry>
      </collision>
    </link>
    <gazebo reference="${axle}_${side}_wheel_link">
      <mu1>${W.mu}</mu1>
      <mu2>${W.mu2}</mu2>
    </gazebo>
  </xacro:macro>

</robot>
