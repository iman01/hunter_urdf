<?xml version="1.0"?>
<!-- Hull / sprung mass of the HUNTeR replica. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Recursive helper: one <collision> per [cx, cy, cz, sx, sy, sz] entry. -->
  <xacro:macro name="box_collisions" params="boxes idx:=0">
    <xacro:if value="${len(boxes) > 0}">
      <xacro:property name="b" value="${boxes[0]}"/>
      <collision name="hull_collision_${idx}">
        <origin xyz="${b[0]} ${b[1]} ${b[2]}" rpy="0 0 0"/>
        <geometry><box size="${b[3]} ${b[4]} ${b[5]}"/></geometry>
      </collision>
      <xacro:box_collisions boxes="${boxes[1:]}" idx="${idx + 1}"/>
    </xacro:if>
  </xacro:macro>

  <xacro:macro name="box_visuals" params="boxes material idx:=0">
    <xacro:if value="${len(boxes) > 0}">
      <xacro:property name="b" value="${boxes[0]}"/>
      <visual name="hull_box_${idx}">
        <origin xyz="${b[0]} ${b[1]} ${b[2]}" rpy="0 0 0"/>
        <geometry><box size="${b[3]} ${b[4]} ${b[5]}"/></geometry>
        <material name="${material}"/>
      </visual>
      <xacro:box_visuals boxes="${boxes[1:]}" material="${material}" idx="${idx + 1}"/>
    </xacro:if>
  </xacro:macro>

  <xacro:macro name="hunter_chassis">
    <xacro:property name="M" value="${V.mass}"/>

    <!-- base_footprint: ground projection of base_link at kerb-weight ride height. -->
    <link name="base_footprint"/>
    <joint name="base_footprint_joint" type="fixed">
      <parent link="base_footprint"/>
      <child link="base_link"/>
      <origin xyz="0 0 ${V.wheel.collision_radius}" rpy="0 0 0"/>
    </joint>

    <!-- base_link: hull frame, midway between the axles, at wheel-centre
         height at kerb-weight static equilibrium; x forward, z up. -->
    <link name="base_link">
      <inertial>
        <origin xyz="${M.chassis_com[0]} ${M.chassis_com[1]} ${M.chassis_com[2]}" rpy="0 0 0"/>
        <mass value="${M.chassis}"/>
        <inertia ixx="${M.chassis_inertia.ixx}" ixy="${M.chassis_inertia.ixy}" ixz="${M.chassis_inertia.ixz}"
                 iyy="${M.chassis_inertia.iyy}" iyz="${M.chassis_inertia.iyz}" izz="${M.chassis_inertia.izz}"/>
      </inertial>
      <xacro:if value="${visual_detail == 'mesh'}">
        <xacro:mesh_visual name="hull" file="hull.stl" material="hunter_green"/>
        <xacro:mesh_visual name="hull_details" file="hull_details.stl" material="hunter_green_dark"/>
        <xacro:mesh_visual name="hull_steel" file="hull_steel.stl" material="steel_dark"/>
        <xacro:mesh_visual name="lamps_white" file="lamps_white.stl" material="lamp_white"/>
        <xacro:mesh_visual name="lamps_amber" file="lamps_amber.stl" material="lamp_amber"/>
        <xacro:mesh_visual name="lamps_red" file="lamps_red.stl" material="lamp_red"/>
        <xacro:mesh_visual name="frame" file="frame.stl" material="steel_dark"/>
      </xacro:if>
      <xacro:unless value="${visual_detail == 'mesh'}">
        <xacro:box_visuals boxes="${V.body.collision_boxes}" material="hunter_green"/>
      </xacro:unless>
      <xacro:box_collisions boxes="${V.body.collision_boxes}"/>
    </link>
  </xacro:macro>

</robot>
