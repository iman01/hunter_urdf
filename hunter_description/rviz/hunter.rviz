Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.55
    Tree Height: 600
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 30
      Reference Frame: base_footprint
      Color: 160; 160; 164
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Suspension linkage
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /suspension_linkage/markers
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Names: false
      Marker Scale: 0.5
      Value: false
    - Class: rviz_default_plugins/PointCloud2
      Name: Front lidar
      Enabled: false
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /front_lidar/points
      Size (m): 0.03
      Style: Points
      Color Transformer: AxisColor
      Value: false
    - Class: rviz_default_plugins/PointCloud2
      Name: Rear lidar
      Enabled: false
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /rear_lidar/points
      Size (m): 0.03
      Style: Points
      Color Transformer: AxisColor
      Value: false
    - Class: rviz_default_plugins/Odometry
      Name: Wheel odometry
      Enabled: false
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /odom
      Keep: 50
      Shape:
        Value: Arrow
      Value: false
    - Class: rviz_default_plugins/Image
      Name: Front driving camera
      Enabled: false
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /front_drive_camera/image_raw
      Value: false
  Enabled: true
  Global Options:
    Background Color: 48; 52; 58
    Fixed Frame: base_footprint
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 11
      Focal Point:
        X: 0
        Y: 0
        Z: 0.6
      Pitch: 0.35
      Yaw: 0.75
      Target Frame: base_footprint
      Value: Orbit (rviz)
    Saved: ~
Window Geometry:
  Height: 1000
  Width: 1600
